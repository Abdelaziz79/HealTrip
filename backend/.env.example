# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Gemini AI Configuration
# Multiple API keys separated by commas for failover
# Example: key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
# All models sorted: newest/fastest → oldest (auto-fallback on failure)
# Tier 1 (Latest): gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-pro
# Tier 2 (Stable): gemini-3.5-flash-lite, gemini-3.1-flash-lite
# Tier 3 (Legacy): gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-pro,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
# Max retries per model before falling back to next model
GEMINI_MAX_RETRIES=3
# Cooldown period (ms) for a failed key before retrying
GEMINI_KEY_COOLDOWN_MS=60000

# Session
# Time-to-live for inactive sessions (ms). Default: 1 hour
SESSION_TTL_MS=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
